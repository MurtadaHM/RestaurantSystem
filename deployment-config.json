  "deployment_steps": {
    "step_1": {
      "title": "Local Testing",
      "commands": [
        "docker-compose up -d",
        "curl http://localhost:5183/swagger/index.html",
        "docker-compose down"
      ]
    },
    "step_2": {
      "title": "Push to GitHub",
      "commands": [
        "git add .",
        "git commit -m 'chore: ready for Render deployment'",
        "git push origin main"
      ]
    },
    "step_3": {
      "title": "Create Render Service",
      "instructions": [
        "Go to https://render.com",
        "Click 'New Web Service'",
        "Select RestaurantSystem repository",
        "Add environment variables",
        "Click 'Deploy'"
      ]
    },
    "step_4": {
      "title": "Post-Deployment",
      "commands": [
        "Apply migrations: dotnet ef database update",
        "Test API: curl https://restaurant-api.onrender.com/swagger",
        "Enable monitoring in Render dashboard",
        "Setup backups"
      ]
    }
  },
  
