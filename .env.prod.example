# ============================================================
# Production Environment Configuration
# ============================================================
# نسخ هذا الملف إلى .env.prod وأكمل بقيمك الفعلية

# Database Configuration (استخدم خادم PostgreSQL خارجي)
DB_HOST=your_external_db_host.com
DB_PORT=5432
DB_NAME=restaurant_prod_db
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password_here

# JWT Configuration
JWT_KEY=your_very_long_secure_jwt_key_here_at_least_256_bits_recommended
JWT_ISSUER=RestaurantSystem
JWT_AUDIENCE=RestaurantSystemUsers
JWT_EXPIRY_MINUTES=1440

# Claude AI Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_BASE_URL=https://api.anthropic.com/v1/

# Sendy Configuration
SENDY_BASE_URL=https://sendy-backend-production.up.railway.app/
SENDY_API_KEY=your_sendy_api_key_here
SENDY_WEBHOOK_SECRET=your_webhook_secret_here

# Team6 Integration
TEAM6_ENABLED=true
TEAM6_BASE_URL=https://rest-back-qoxj.onrender.com
TEAM6_RESTAURANT_ID=21111111-1111-1111-1111-111111111112
TEAM6_POLLING_INTERVAL=10
TEAM6_FALLBACK_USER_ID=eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee

# Server Configuration
API_PORT=5183
LOG_LEVEL=Warning
