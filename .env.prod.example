# ============================================================
# Production Environment Configuration for Render
# ============================================================
# نسخ هذا الملف إلى .env.prod وأكمل بقيمك الفعلية

# Database Configuration (PostgreSQL Connection String from Render Internal)
# مثال من Render Internal Database URL:
# postgresql://user:pass@dpg-xxxxx-a/dbname  →  يتم تحويله إلى صيغة .NET
ConnectionStrings__DefaultConnection=Host=dpg-d7h98mosfn5c73ce6cl0-a;Port=5432;Database=restaurantdb_89we;Username=restaurantuser;Password=YOUR_PASSWORD_HERE;SSL Mode=Require;Trust Server Certificate=true

# JWT Configuration
Jwt__Key=your_very_long_secure_jwt_key_here_at_least_256_bits_recommended
Jwt__Issuer=RestaurantSystem
Jwt__Audience=RestaurantSystemUsers
Jwt__ExpiryInMinutes=1440

# Claude AI Configuration
Claude__ApiKey=your_claude_api_key_here
Claude__Model=claude-3-haiku-20240307
Claude__BaseUrl=https://api.anthropic.com/v1/

# Sendy Configuration
SendyConfig__BaseUrl=https://sendy-backend-production.up.railway.app/
SendyConfig__ApiKey=your_sendy_api_key_here
SendyConfig__AdminRoute=api/v1/store/integrations
SendyConfig__WebhookSecret=your_webhook_secret_here

# Team6 Integration
Team6Integration__Enabled=false
Team6Integration__BaseUrl=https://rest-back-qoxj.onrender.com
Team6Integration__ActiveOrdersPath=/api/team10/orders/tracking
Team6Integration__RestaurantId=21111111-1111-1111-1111-111111111112
Team6Integration__PollingIntervalSeconds=10
Team6Integration__FallbackUserId=eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee

# Reservation Status Worker Configuration
ReservationStatusWorker__Enabled=false

# Server Configuration
ASPNETCORE_ENVIRONMENT=Production
LOG_LEVEL=Warning

