{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiryInMinutes": "${JWT_EXPIRY_MINUTES}"
  },
  "Claude": {
    "ApiKey": "${CLAUDE_API_KEY}",
    "Model": "${CLAUDE_MODEL}",
    "BaseUrl": "${CLAUDE_BASE_URL}"
  },
  "SendyConfig": {
    "BaseUrl": "${SENDY_BASE_URL}",
    "ApiKey": "${SENDY_API_KEY}",
    "AdminRoute": "api/v1/store/integrations",
    "WebhookSecret": "${SENDY_WEBHOOK_SECRET}"
  },
  "Team6Integration": {
    "Enabled": "${TEAM6_ENABLED}",
    "BaseUrl": "${TEAM6_BASE_URL}",
    "ActiveOrdersPath": "/api/team10/orders/tracking",
    "RestaurantId": "${TEAM6_RESTAURANT_ID}",
    "PollingIntervalSeconds": "${TEAM6_POLLING_INTERVAL}",
    "FallbackUserId": "${TEAM6_FALLBACK_USER_ID}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "${LOG_LEVEL}",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}